    "tcross_year_to_tbjd_documentation": {
      "method": "tcross_bjd ≈ 2451545.0 + (tcross_year - 2000.0) × 365.25 - 2457000.0 = -5455.0 + (tcross_year - 2000.0) × 365.25",
      "rationale": "Uses mean tropical year of 365.25 days from J2000.0 epoch. The approximation is ~1 day accurate; the paper gives crossing times rounded to 0.01 yr, so this matches the published precision. No leap-year or delta-T correction applied. TBJD convention: BJD_TDB minus 2457000.0.",
      "precision": "Values rounded to 2 decimal places, matching the 0.01-year precision of the published crossing times.",
      "units": "days (TBJD)"
    },
    "cycle_mid_times": {
