{
  "metadata": {
    "title": "Betty Hill Star Map (Fish Interpretation)",
    "version": "1.1",
    "description": "Encoded graph of the star map Betty Hill sketched during hypnotic regression (1961), with Marjorie Fish's star identifications (1974). J2000 coordinates from Hipparcos catalog via skyfield.",
    "source_citation": "Dickinson, T. (1974). 'The Zeta Reticuli Incident.' Astronomy, 2(6): 4-17.",
    "secondary_sources": [
      "Soter, S. (1978). 'Betty Hill's Star Map.' Astronomy, 6(11): 6.",
      "Sturrock, P. (1987). An Analysis of the Betty Hill Star Map. SUIPR Report No. 1021.",
      "Fish, M. (1973-1978). Personal correspondence and model construction, as cited in Dickinson (1974)."
    ],
    "star_selection_caveat": "Fish selected ~15 stars from ~330 within 65 ly that best matched the sketch. Statistical significance is contested (Soter 1978). This analysis treats the graph structure as-is, not as a selection-corrected test.",
    "coordinate_note": "J2000 RA/Dec from Hipparcos. Resolved via skyfield Star(ra_hours, dec_degrees) using DE441 ephemeris. Small ~0.01deg proper-motion corrections not applied (insignificant for pairwise angular separations)."
  },
