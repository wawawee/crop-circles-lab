#!/usr/bin/env bash
# Cursor-facing shortcut: dispatch a prompt to OpenCode headless.
# Usage:
#   opencode-dispatch "Investigate X…"
#   opencode-dispatch --wait --model opencode/deepseek-v4-flash-free "…"
#   opencode-dispatch --attach http://localhost:4096 "…"
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
has_backend=0
for arg in "$@"; do
  if [[ "$arg" == "--backend" || "$arg" == --backend=* ]]; then
    has_backend=1
    break
  fi
done
if [[ $has_backend -eq 0 ]]; then
  exec python3 "$ROOT/tools/scripts/dispatch_external_agent.py" --backend opencode "$@"
else
  exec python3 "$ROOT/tools/scripts/dispatch_external_agent.py" "$@"
fi
